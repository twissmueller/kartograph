# The Angular image. Copy to web/Dockerfile and fix the dist path.
#
# Stage 1 builds with Node, stage 2 is nginx serving static files: no Node in the
# running container.

FROM node:20-alpine AS builder

WORKDIR /app

# package files first, so `npm ci` is its own cached layer.
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine

# Angular 17+ writes dist/<project>/browser; older versions write dist/<project>.
# Check `ng build`'s output before trusting this line.
COPY --from=builder /app/dist/*/browser /usr/share/nginx/html

# The server block, inline so this example is one file. Move it to web/nginx.conf
# and `COPY nginx.conf /etc/nginx/conf.d/default.conf` when it grows. Heredocs in
# a Dockerfile need BuildKit, which Docker Desktop uses by default.
COPY <<'NGINX' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml;

    # Uploads are refused by the application, which answers with a message naming
    # the limit, rather than by the proxy, whose bare 413 the UI can only render
    # as "please try again". So set this ABOVE the server's own limit.
    client_max_body_size 30m;

    # The API, so the browser talks to one origin and no CORS is needed. The host
    # name is the compose service name; in production the frontend is served by a
    # CDN instead and this block is unused.
    location /api/ {
        proxy_pass http://server:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Long-lived, content-hashed build output.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Every other path is a route of the single-page app, answered with the shell.
    # Without this, a reload on a deep link is a 404 from nginx.
    location / {
        try_files $uri /index.html;
    }
}
NGINX

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80 || exit 1

CMD ["nginx", "-g", "daemon off;"]
