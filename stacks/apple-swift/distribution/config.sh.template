# distribution/config.sh — the project's identifiers and paths for the delivery scripts.
# Filled by kartograph-deliver on first use from what the build files reveal; edit freely.
# Empty means not configured: a script that needs a key stops and names it. No secrets here,
# only paths to key files under your home directory.

APP_NAME=""                      # display name
STACK="apple-swift"
LANES="ios mac"                  # subset of: ios mac
LOCALES="en-US"                  # store locales, space-separated

# Apple
TEAM_ID=""                       # Apple Developer team id (10 characters)
APPLE_BUNDLE_ID=""               # one id for iOS and macOS (Universal Purchase)
ASC_APP_ID=""                    # numeric App Store Connect app id; the record is created in the web UI, never by API
ASC_KEY_ID=""                    # App Store Connect API key id
ASC_ISSUER_ID=""                 # its issuer id
ASC_KEY_PATH="$HOME/.private_keys/AuthKey_${ASC_KEY_ID}.p8"
IOS_PROJECT=""                   # path to the .xcodeproj or .xcworkspace, relative to the project root
IOS_SCHEME=""
MAC_PROJECT=""                   # empty when the Mac app lives in the same project
MAC_SCHEME=""
VERSION_FILE=""                  # the file holding MARKETING_VERSION and CURRENT_PROJECT_VERSION: an .xcconfig or project.yml
MAC_VERSION_FILE=""              # the Mac app's own .xcconfig when MAC_PROJECT has its own configuration; every version/build write goes to VERSION_FILE and this one; empty when the Mac app reads VERSION_FILE
XCODEGEN="no"                    # yes when the Xcode project is generated from project.yml
IOS_PROFILE_NAME=""              # empty → automatic signing; else manual signing with this App Store profile (created by the API when absent)
MAC_PROFILE_NAME=""
SIMULATOR="iPad Pro 13-inch (M4)"
TESTFLIGHT_GROUP="Internal Testing"
BETA_FEEDBACK_EMAIL=""

# Hooks — optional shell functions the scripts call when this file defines them
# post_archive_hook PLATFORM ARCHIVE — deploy-testflight.sh calls it right after archiving
# (PLATFORM is ios or mac, ARCHIVE the .xcarchive path), before export, validation and upload;
# a non-zero status stops the run before anything leaves the machine. Use it to refuse an
# archive the store would accept but that is broken, e.g. a Mac app signed without its
# sandbox network entitlement:
# post_archive_hook() {
#   [ "$1" = mac ] || return 0
#   "$PROJECT_ROOT/scripts/check-mac-entitlements.sh" "$2"
# }
